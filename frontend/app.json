{
  "expo": {
    "name": "FixConnect",
    "slug": "fixconnect-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "fixconnect",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixconnect.user",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FixConnect needs your location to find nearby service providers and set your service address.",
        "NSLocationAlwaysUsageDescription": "FixConnect uses your location to track your active service booking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#E8F5E9"
      },
      "package": "com.fixconnect.user",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FixConnect needs your location to match you with nearby providers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
